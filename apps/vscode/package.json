{
  "name": "makefmt",
  "displayName": "makefmt - Makefile & justfile Formatter",
  "description": "Fast, safe Makefile and justfile formatter. Aligns assignments and line continuations, indents conditionals, formats recipes as shell, and formats justfiles like just --fmt.",
  "version": "0.0.0",
  "publisher": "NazmusSayad",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1e293b",
    "theme": "dark"
  },
  "license": "MIT",
  "pricing": "Free",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/NazmusSayad/makefmt"
  },
  "homepage": "https://github.com/NazmusSayad/makefmt#readme",
  "bugs": {
    "url": "https://github.com/NazmusSayad/makefmt/issues"
  },
  "categories": [
    "Formatters"
  ],
  "keywords": [
    "makefile",
    "make",
    "gnu make",
    "mk",
    "just",
    "justfile",
    "formatter",
    "format",
    "beautify",
    "prettier"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./dist/extension.js",
  "browser": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:makefile",
    "onLanguage:just"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "languages": [
      {
        "id": "just",
        "aliases": [
          "Just",
          "justfile"
        ],
        "filenames": [
          "justfile",
          "Justfile",
          ".justfile"
        ],
        "extensions": [
          ".just"
        ]
      }
    ],
    "configuration": {
      "title": "makefmt",
      "properties": {
        "makefmt.alignAssignments": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Align the assignment operators of consecutive variable assignments."
        },
        "makefmt.alignAcrossComments": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Keep aligning assignment operators across comment lines instead of starting a new group."
        },
        "makefmt.alignContinuations": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Align the trailing backslashes of continued lines."
        },
        "makefmt.formatRecipes": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Format recipe lines as sh or bash with the rules of shfmt. Recipes that can't be formatted safely are left as they are."
        },
        "makefmt.indentConditionals": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Indent the contents of conditional blocks such as ifeq and ifdef."
        },
        "makefmt.indentWidth": {
          "type": "integer",
          "default": 2,
          "minimum": 0,
          "scope": "resource",
          "description": "Spaces per indentation level."
        },
        "makefmt.maxBlankLines": {
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "scope": "resource",
          "description": "Most consecutive blank lines to keep."
        },
        "makefmt.trimTrailingWhitespace": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Also trim trailing whitespace on variable assignment lines. Off by default because make keeps that whitespace in the variable's value."
        }
      }
    },
    "configurationDefaults": {
      "[makefile]": {
        "editor.defaultFormatter": "NazmusSayad.makefmt"
      },
      "[just]": {
        "editor.defaultFormatter": "NazmusSayad.makefmt"
      }
    }
  },
  "scripts": {
    "build:wasm": "pnpm --filter @makefmt/wasm build && mkdir -p dist && cp node_modules/@makefmt/wasm/dist/makefmt.wasm dist/makefmt.wasm",
    "build": "pnpm build:wasm && esbuild src/extension.ts --bundle --outfile=dist/extension.js --format=cjs --platform=neutral --target=es2022 --external:vscode --minify",
    "typecheck": "tsc --noEmit",
    "package": "pnpm build && cp ../../LICENSE LICENSE && vsce package --no-dependencies --out makefmt.vsix"
  },
  "devDependencies": {
    "@makefmt/wasm": "workspace:*",
    "@types/vscode": "~1.100.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
